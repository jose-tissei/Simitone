<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <TargetFramework>net9.0</TargetFramework>
    <Nullable>disable</Nullable>
    <IsPackable>false</IsPackable>
    <LangVersion>latest</LangVersion>
  </PropertyGroup>
  <ItemGroup>
    <!-- the pure logic is shared by source so the tests need no game assemblies -->
    <Compile Include="..\Conversations\Logic\*.cs" Link="Logic\%(Filename)%(Extension)" />
    <Compile Include="..\Conversations\Logic\Gossip\*.cs" Link="Logic\Gossip\%(Filename)%(Extension)" />
    <Compile Include="..\Render\Logic\*.cs" Link="RenderLogic\%(Filename)%(Extension)" />
    <Compile Include="..\HtmlUi\Template.cs" Link="HtmlUi\Template.cs" />
    <Compile Include="..\Conversations\Game\ThemeTokens.cs" Link="HtmlUi\ThemeTokens.cs" />
  </ItemGroup>
  <ItemGroup>
    <PackageReference Include="Newtonsoft.Json" Version="13.0.3" />
    <PackageReference Include="Microsoft.NET.Test.Sdk" Version="17.12.0" />
    <PackageReference Include="xunit" Version="2.9.2" />
    <PackageReference Include="xunit.runner.visualstudio" Version="2.8.2" />
  </ItemGroup>
</Project>
